# ==============================================================================
# CẤU HÌNH NGINX CHUẨN ĐỂ DEPLOY AIMS FRONTEND TRÊN LINUX SERVER
# Đặt tại: /etc/nginx/conf.d/aims-frontend.conf hoặc /etc/nginx/sites-available/
# ==============================================================================

server {
    listen 80;
    server_name aims.yourdomain.com; # Thay thế bằng domain hoặc IP server Linux của bạn

    # Tùy chọn: Chuyển hướng toàn bộ HTTP sang HTTPS
    # return 301 https://$host$request_uri;

    # Thư mục chứa mã nguồn đã build (dist/)
    root /var/www/aims-admin-frontend/dist;
    index index.html;

    # Giới hạn dung lượng tải lên (Upload file tài liệu, hợp đồng, tài sản)
    client_max_body_size 50M;

    # Bật nén Gzip tăng tốc độ tải trang
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # 1. Cấu hình phục vụ Single Page Application (React Router)
    # Tránh lỗi 404 Not Found khi F5 lại trang
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 2. Cache các file tĩnh (JS, CSS, Ảnh) để tải trang cực nhanh
    location ~* \.(?:css(\.map)?|js(\.map)?|jpe?g|png|gif|ico|cur|heic|webp|tiff?|mp3|m4a|aac|ogg|midi?|wav|mp4|mov|webm|mpe?g|avi|ogv|flv|wmv|svgz?|ttf|ttc|otf|eot|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # 3. Reverse Proxy API sang Backend (Khắc phục triệt để lỗi CORS & HttpOnly Cookie)
    location /api/ {
        # Địa chỉ máy chủ Backend thực tế
        proxy_pass https://10.10.92.65:8687;

        # Chuyển tiếp các Header nhận diện client
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Cấu hình cần thiết cho HttpOnly Cookie
        proxy_cookie_path / /;
        proxy_pass_header Set-Cookie;

        # Nếu backend dùng chứng chỉ SSL nội bộ / tự ký
        proxy_ssl_verify off;
        proxy_ssl_server_name on;

        # Timeout cho các tác vụ nặng (như batch import Excel)
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
